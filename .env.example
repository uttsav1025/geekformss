# Every variable the server reads. Validated at boot by server/src/config/env.ts:
# the process exits with a list of problems if anything is missing or malformed.

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
# docker compose maps Postgres to 5433 to avoid clashing with a local install.
# Hosted Postgres (Neon etc.): use the provided URL; TLS is enabled automatically.
DATABASE_URL=postgres://survey:survey@localhost:5433/survey
# Optional direct (non-pooled) URL for migrations. On Neon, use the -pooler host
# for DATABASE_URL and the plain host here (`neon init` writes both).
DATABASE_URL_UNPOOLED=
PG_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED, no defaults: at least 32 characters each, different from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
REFRESH_SECRET=
# Access token lifetime (Authorization header) and refresh token lifetime (httpOnly cookie).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost (4-15). 12 ≈ 250 ms per hash.
HASH_SALT_ROUND=12

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. In production the client is served from the
# same origin, so this only matters for a separately hosted frontend.
CORS_ORIGIN=http://localhost:5173
# Proxy hops in front of the app (Render, Fly, nginx = 1) so rate limits see real client IPs.
TRUST_PROXY=0

# ── Survey behaviour ─────────────────────────────────────────────────────────
# Final submissions allowed per IP per 10 minutes.
SUBMIT_LIMIT=10
# Autosaved-but-never-submitted responses are deleted after this many days
# (startup + every 6 hours) and never counted as "in progress".
PARTIAL_TTL_DAYS=30

# ── Demo seed (npm run db:seed) ──────────────────────────────────────────────
# Outside production these default to demo@geekforms.dev / demo12345.
# In production the seed refuses to run unless both are set.
DEMO_EMAIL=
DEMO_PASSWORD=

# ── Client build (Vite) ──────────────────────────────────────────────────────
# Show the demo login hint on the login page in a production build.
VITE_SHOW_DEMO=false
